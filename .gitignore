# Package-local marker; do not commit secrets.

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.backup-*
*-backup-*/
*-backups/

# Frontend dependencies and build output
node_modules/
build/
dist/

# Local backup snapshots (keep recovery copies out of source control)
/backend/*backup*
/backend/*.backup-*
/backend/*.backup.*
/frontend/src/**/*.backup-*
/frontend/src/**/*.backup.*
*.bak
*.log
.vercel/
