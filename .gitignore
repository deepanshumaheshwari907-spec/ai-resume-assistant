# Package-local marker; do not commit secrets.

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.backup-*
*-backup-*/
*-backups/

# Frontend dependencies and build output
node_modules/
build/
dist/

# Local backup snapshots
*backup*/
*backup*
*.backup.*
*.backup-*
*.bak
